{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean highs-build in public directory",
            "type": "shell",
            "command": "Remove-Item",
            "args": [
                "-Path",
                "${workspaceFolder}\\public\\highs-build",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Copy highs-build from node_modules to public directory",
            "type": "shell",
            "command": "Copy-Item",
            "args": [
                "-Path",
                "${workspaceFolder}\\node_modules\\highs\\build",
                "-Destination",
                "${workspaceFolder}\\public\\highs-build",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Update highs-build",
            "dependsOn": [
                "Clean highs-build in public directory",
                "Copy highs-build from node_modules to public directory"
            ],
        },
    ]
}